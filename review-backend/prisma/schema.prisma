// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// For more information about Prisma Client, see:
// https://www.prisma.io/docs/orm/prisma-client

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Admin model for the admin panel
model Admin {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique
  password  String?  @db.VarChar(255) // Made optional for OAuth users
  imageUrl  String?  // Profile image URL
  profileImage String? // OAuth profile image
  contact   String?  @db.VarChar(15)
  dob       DateTime?
  gender    String?  @db.VarChar(10)
  address   String?
  city      String?
  state     String?
  instagram String?
  facebook  String?
  twitter   String?
  // Google OAuth fields
  googleId    String? @unique
  isVerified  Boolean @default(false)
  // Email verification fields
  verificationToken String?
  verificationTokenExpires DateTime?
  emailVerifiedAt DateTime?
  // Profile completion tracking
  profileCompleted Boolean @default(false)
  // Manual payout destination. Unique so one UPI ID cannot be shared across accounts.
  upiId String? @unique @db.VarChar(256)
  createdAt DateTime @default(now())
  reviews   Review[]
  sentMessages ChatMessage[] @relation("MessageSender") // Opposite relation for sender
  receivedMessages ChatMessage[] @relation("MessageRecipient") // Opposite relation for recipient
  likes     Like[]   // Relationship to Like model
  rewardLedger RewardLedger[]
  withdrawalRequests WithdrawalRequest[]
  rewardFlags RewardFlag[]
}

model Review {
  id        Int      @id @default(autoincrement())
  entity    String   @db.VarChar(255) // Renamed from "product" to support universal reviews
  rating    Int
  review    String
  imageUrl  String?
  videoUrl  String?
  mediaUrls String[] // Array of image/video URLs
  title     String   @db.VarChar(255)
  content   String
  category  String?  @db.VarChar(100)
  tags      String[] // Add tags for categorization
  likeCount Int      @default(0) // Track total likes for this review
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  chatMessages ChatMessage[]
  likes     Like[]   // Relationship to Like model

  // Affiliate Link System
  affiliateEnabled            Boolean   @default(false)
  affiliatePlatform           String?   @db.VarChar(50) // AMAZON | FLIPKART | MEESHO | MYNTRA | AJIO | NYKAA | CROMA
  affiliateLink               String?   @db.Text
  affiliateStatus             String?   @db.VarChar(30) // PENDING_VERIFICATION | APPROVED | NEEDS_CHANGES | REJECTED | AUTO_APPROVED | AUTO_REJECTED
  aiSpamScore                 Float?    // 0-100, higher = more likely spam
  aiSpamReasons               String[]  // Reasons from AI analysis
  affiliateVerifiedBy         Int?      // Admin ID who verified
  affiliateVerifiedAt         DateTime?
  affiliateNeedsChangesReason String?   @db.Text
  affiliateRejectionReason    String?   @db.Text
  affiliateClickCount         Int       @default(0)
  affiliateSubmittedAt        DateTime?
  affiliateLinkHealth         String?   @db.VarChar(20) // HEALTHY | BROKEN | REDIRECT_CHANGED | UNKNOWN
  affiliateLinkLastCheckedAt  DateTime?
  affiliateLinkHttpStatus     Int?

  affiliateAuditLogs AffiliateAuditLog[]

  // Reward gate. Public visibility is unchanged. Null means the review predates rewards.
  // INELIGIBLE | PENDING | FLAGGED | APPROVED | REJECTED | REVERSED
  rewardStatus String? @db.VarChar(20)
  contentHash String? @db.VarChar(64)
  submissionIpHash String? @db.VarChar(64)
  rewardLedger RewardLedger[]

  @@index([affiliateEnabled, affiliateStatus])
  @@index([affiliateStatus])
  @@index([authorId, contentHash])
  @@index([rewardStatus])
  @@index([submissionIpHash])
}

model ChatMessage {
  id          Int      @id @default(autoincrement())
  content     String
  mediaUrl    String?  // URL for attachments (images, documents, voice messages)
  mediaType   String?  // Type of media: "image", "audio", "document", etc.
  reviewId    Int?
  review      Review?  @relation(fields: [reviewId], references: [id])
  senderId    Int
  sender      User     @relation("MessageSender", fields: [senderId], references: [id])
  recipientId Int
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id])
  isRead      Boolean  @default(false)
  // isSent removed as it doesn't exist in the database
  isDelivered Boolean  @default(false)  // Message was delivered to recipient
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // For reply functionality
  replyToId   Int?     // ID of the message being replied to
  replyTo     ChatMessage? @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     ChatMessage[] @relation("Replies")
}

model SupportRequest {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  priority  String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  status    String   @default("PENDING") // PENDING, IN_PROGRESS, RESOLVED, CLOSED
  response  String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailSubscription {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  isActive  Boolean  @default(true)
  lastEmailSent DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  @@index([email])
  @@index([token])
}

model Like {
  id       Int      @id @default(autoincrement())
  userId   Int
  reviewId Int
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review   Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  @@unique([userId, reviewId]) // Prevent duplicate likes from same user on same review
  @@index([reviewId]) // Index for efficient review like queries
  @@index([userId]) // Index for efficient user like queries
}

model PushSubscription {
  id         Int      @id @default(autoincrement())
  userId     Int
  endpoint   String   @db.Text
  p256dh     String   @db.Text
  auth       String   @db.Text
  userAgent  String?  @db.Text
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@unique([userId, endpoint]) // Prevent duplicate subscriptions
  @@index([userId])
  @@index([isActive])
}

model BlogPost {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  slug        String   @unique
  excerpt     String   @db.Text // Brief summary
  content     String   @db.Text // Full article content
  coverImage  String?  // Featured image URL
  category    String   @db.VarChar(100)
  tags        String[] // Array of tags
  author      String   @db.VarChar(100)
  authorImage String?  // Author profile image
  readTime    Int      @default(5) // Estimated read time in minutes
  viewCount   Int      @default(0) // Track article views
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([slug])
  @@index([category])
  @@index([isPublished])
  @@index([publishedAt])
}

// Affiliate Link System - Audit Log
model AffiliateAuditLog {
  id        Int      @id @default(autoincrement())
  reviewId  Int
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  adminId   Int?     // NULL for automated actions
  action    String   @db.VarChar(30) // APPROVED | REJECTED | NEEDS_CHANGES | RESUBMITTED | AUTO_APPROVED | AUTO_REJECTED
  reason    String?  @db.Text
  aiSpamScore Float? // Score at time of action
  createdAt DateTime @default(now())

  @@index([reviewId])
  @@index([adminId])
  @@index([action])
}

// Trusted Reviewer Program (future scalability)
model TrustedReviewer {
  id            Int       @id @default(autoincrement())
  userId        Int       @unique
  approvedCount Int       @default(0)
  rejectedCount Int       @default(0)
  isTrusted     Boolean   @default(false)
  trustedSince  DateTime?
  lastAuditAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([isTrusted])
}

// In-App Notification System
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      // Recipient user ID
  type      String   @db.VarChar(50) // AFFILIATE_APPROVED | AFFILIATE_REJECTED | AFFILIATE_NEEDS_CHANGES | GENERAL
  title     String   @db.VarChar(255)
  message   String   @db.Text
  metadata  String?  @db.Text // JSON string for extra data (reviewId, etc.)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// Immutable reward and withdrawal ledger. Rows are inserted, never updated or deleted.
model RewardLedger {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId     Int?
  review       Review?  @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  withdrawalId Int?
  withdrawal   WithdrawalRequest? @relation(fields: [withdrawalId], references: [id])
  // REVIEW_CREDIT | REVIEW_REVERSAL | WITHDRAWAL_DEBIT | WITHDRAWAL_REVERSAL
  entryType    String   @db.VarChar(30)
  amount       Int
  note         String?  @db.Text
  createdAt    DateTime @default(now())

  @@unique([reviewId, entryType])
  @@index([userId, entryType])
  @@index([withdrawalId])
}

// Manual UPI withdrawal. openKey is user-{id} while PENDING or APPROVED, and null after that.
model WithdrawalRequest {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Int
  upiId           String    @db.VarChar(256)
  // PENDING | APPROVED | REJECTED | PAID
  status          String    @db.VarChar(20)
  openKey         String?   @unique @db.VarChar(40)
  rejectionReason String?   @db.Text
  reviewedBy      Int?
  reviewedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  ledger          RewardLedger[]

  @@index([userId, status])
  @@index([status, createdAt])
}

// Suspicious-activity queue. OPEN flags block withdrawals until an admin clears them.
model RewardFlag {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId  Int?
  reason    String    @db.VarChar(80)
  details   String?   @db.Text
  // OPEN | CLEARED
  status    String    @default("OPEN") @db.VarChar(20)
  createdAt DateTime  @default(now())
  clearedAt DateTime?
  clearedBy Int?

  @@index([userId, status])
  @@index([reviewId])
}